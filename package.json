{
  "name": "chafe",
  "version": "0.1.0",
  "description": "Mine your coding-agent session logs for repeated friction and turn it into evidence-backed AGENTS.md / CLAUDE.md rules.",
  "keywords": [
    "claude-code",
    "agents-md",
    "claude-md",
    "coding-agent",
    "developer-tools",
    "cli",
    "session-logs",
    "local-first"
  ],
  "license": "MIT",
  "author": "Nithinfgs",
  "homepage": "https://github.com/Nithinfgs/chafe#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nithinfgs/chafe.git"
  },
  "bugs": {
    "url": "https://github.com/Nithinfgs/chafe/issues"
  },
  "type": "module",
  "bin": {
    "chafe": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "examples",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "demo:gen": "node scripts/gen-demo.mjs",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && node --test \"dist/test/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  }
}
